@model IReadOnlyList<FunktsiooniUurimineWeb.Models.FunktsiooniUurimine>
@{
    ViewData["Title"] = "Funktsioonide ajalugu";
}

<section class="hero">
    <div>
        <p class="eyebrow">RAKTILINE PROJEKT</p>
        <h1>Funktsioonide ajalugu</h1>
        <p class="lead">Siin saad avada varem salvestatud funktsioonid ja vaadata nende täielikke lahendusi.</p>
    </div>
    <a class="button" asp-action="Create">+ Salvesta uus funktsioon</a>
</section>

<div class="card">
    <div class="card-header">
        <h2>Salvestatud funktsioonid</h2>
        <span class="badge">@Model.Count kokku</span>
    </div>
    @if (Model.Count == 0)
    {
        <div class="empty">Funktsioone pole veel lisatud.</div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Valem</th>
                        <th>Määramispiirkond</th>
                        <th>Nullkohad</th>
                        <th>Tuletis</th>
                        <th>Loodud</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><code>@item.Valem</code></td>
                        <td>@item.Maaramispiirkond</td>
                        <td>@item.Nullkohad</td>
                        <td><code>@item.Tuletis</code></td>
                        <td>@item.LuodudAeg.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="actions">
                            <a asp-action="Details" asp-route-id="@item.Id">Vaata</a>
                            <a asp-action="Edit" asp-route-id="@item.Id">Muuda</a>
                            <a class="danger-link" asp-action="Delete" asp-route-id="@item.Id">Kustuta</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

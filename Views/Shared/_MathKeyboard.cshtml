<div class="math-keyboard" id="mathKeyboard" data-target-id="Valem">
    <div class="keyboard-topline">
        <div>
            <div class="keyboard-title">Matemaatiline klaviatuur</div>
            <div class="keyboard-subtitle">Nupud sisestavad ainult rakenduse toetatud sümboleid ja funktsioone.</div>
        </div>
        <div class="keyboard-actions">
            <button type="button" class="key key-action" data-action="backspace" title="Kustuta eelnev märk" aria-label="Kustuta eelnev märk">⌫</button>
            <button type="button" class="key key-action danger-soft" data-action="clear" title="Tühjenda kogu valem" aria-label="Tühjenda kogu valem">C</button>
        </div>
    </div>

    <div class="keyboard-grid keyboard-grid-main" aria-label="Numbrid ja tehted">
        <button type="button" class="key" data-insert="7">7</button>
        <button type="button" class="key" data-insert="8">8</button>
        <button type="button" class="key" data-insert="9">9</button>
        <button type="button" class="key op" data-insert="/">÷</button>
        <button type="button" class="key op" data-insert="*">×</button>
        <button type="button" class="key" data-insert="(">(</button>

        <button type="button" class="key" data-insert="4">4</button>
        <button type="button" class="key" data-insert="5">5</button>
        <button type="button" class="key" data-insert="6">6</button>
        <button type="button" class="key op" data-insert="-">−</button>
        <button type="button" class="key op" data-insert="+">+</button>
        <button type="button" class="key" data-insert=")">)</button>

        <button type="button" class="key" data-insert="1">1</button>
        <button type="button" class="key" data-insert="2">2</button>
        <button type="button" class="key" data-insert="3">3</button>
        <button type="button" class="key op" data-insert="^">xⁿ</button>
        <button type="button" class="key op" data-action="square">x²</button>
        <button type="button" class="key constant" data-insert="pi">π</button>

        <button type="button" class="key zero" data-insert="0">0</button>
        <button type="button" class="key" data-insert=".">.</button>
        <button type="button" class="key variable" data-insert="x">x</button>
        <button type="button" class="key constant" data-insert="e">e</button>
        <button type="button" class="key key-enter" data-action="focus-end">↳</button>
        <button type="button" class="key" data-action="clear">AC</button>
    </div>

    <div class="keyboard-section-label">Funktsioonid</div>
    <div class="keyboard-grid keyboard-grid-functions" aria-label="Matemaatilised funktsioonid">
        <button type="button" class="key function" data-wrap="sin">sin( )</button>
        <button type="button" class="key function" data-wrap="cos">cos( )</button>
        <button type="button" class="key function" data-wrap="tan">tan( )</button>
        <button type="button" class="key function" data-wrap="sqrt">√( )</button>
        <button type="button" class="key function" data-wrap="ln">ln( )</button>
        <button type="button" class="key function" data-wrap="log">log( )</button>
        <button type="button" class="key function" data-wrap="exp">exp( )</button>
        <button type="button" class="key function" data-wrap="abs">abs( )</button>
    </div>

    <div class="keyboard-help">
        <span><kbd>^</kbd> aste</span>
        <span><kbd>*</kbd> korrutamine</span>
        <span><kbd>/</kbd> jagamine</span>
        <span>Vali valemis osa ja vajuta <b>sin( )</b>, <b>√( )</b> jne — valik mähitakse automaatselt funktsiooni sisse.</span>
    </div>
</div>
